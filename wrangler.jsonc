{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onebe-os",
  "compatibility_date": "2026-09-18",
  "main": "dist/server/index.js",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
}
