{
  "name": "onebe-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "cross-env VITE_AUTH_MODE=mock vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --env local --port 8787 --local",
    "db:local": "wrangler d1 migrations apply DB --env local --local",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:auth": "tsx --test server/*.test.ts",
    "test:auth:browser": "playwright test --config playwright.auth.config.ts",
    "check": "tsc -b",
    "format": "prettier --write src server tests *.ts *.json index.html",
    "predeploy": "node scripts/check-deploy.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-env": "^10.1.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
  }
}
