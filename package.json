{
  "name": "onebe-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-build.mjs && tsc -b && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:server && playwright test",
    "test:server": "node --experimental-transform-types --test server/*.test.ts",
    "check": "tsc -b",
    "format": "prettier --write src tests *.ts *.json index.html",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
  }
}
